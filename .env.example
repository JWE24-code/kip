# Copy this file to .env and fill in the section for whichever PROVIDER you
# use. Loaded automatically by peck.js/groom.js/hatch.js via dotenv.
#
# IMPORTANT: if coop/.henhouse/llm.json exists, it takes precedence over
# these env vars, field by field (a field the file doesn't set still falls
# back to its env var here). That file is meant to be read/written by a GUI
# app (scripts/lib/llm.js's loadLLMConfig/saveLLMConfig) without touching
# shell env vars — see its shape in scripts/lib/llm.js. This .env file
# remains the CLI-only / no-GUI path, and the fallback when the config file
# doesn't exist or doesn't set a given field.

# Which LLM backend scripts/lib/llm.js routes calls to. One of:
# anthropic (default) | openai | deepseek | local | other
PROVIDER=anthropic

# --- anthropic (PROVIDER=anthropic) ---
# Anthropic Messages API. Model defaults to claude-sonnet-4-6 (no env var
# override here — set coop/.henhouse/llm.json's providers.anthropic.model
# to use a different one).
ANTHROPIC_API_KEY=

# --- openai (PROVIDER=openai) ---
# Any OpenAI-compatible chat completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- deepseek (PROVIDER=deepseek) ---
# DeepSeek's OpenAI-compatible endpoint (fixed base URL, not configurable).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- local (PROVIDER=local) ---
# Any local OpenAI-compatible server, e.g. Ollama (`ollama serve`). No API
# key needed. LOCAL_MODEL must be a model tag you've already pulled
# (`ollama pull <model>`).
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# --- other (PROVIDER=other) ---
# Any other OpenAI-compatible endpoint (Kimi/Moonshot, Qwen via DashScope, a
# custom proxy, ...). Unlike "local" there's no default base URL, and an API
# key is supported (most remote "other" endpoints need one).
OTHER_BASE_URL=
OTHER_API_KEY=
OTHER_MODEL=

# --- hatch tracing (optional) ---
# Set to 1 to make scripts/hatch-all.js stream every LLM call — full prompt
# and response, plus the model's reasoning text when the provider exposes it
# — to <coop>/.roost/hatch-trace.jsonl. Same as passing --trace. Off by
# default; the content-free per-run metrics in .roost/hatch-metrics.json are
# always written regardless.
KIP_HATCH_TRACE=

# --- peck tracing (optional) ---
# Same as KIP_HATCH_TRACE but for Peck (scripts/chat.js / scripts/peck.js):
# streams every LLM call AND every skill run (full input/output) to
# <coop>/.roost/peck-trace.jsonl. The content-free .roost/peck-metrics.json
# is always written.
KIP_PECK_TRACE=

# --- reminders tracing (optional) ---
# Same, for scripts/reminders.js --due (the meeting-prep LLM call): streams to
# <coop>/.roost/reminders-trace.jsonl.
KIP_REMINDER_TRACE=

# --- Peck skills: web-search (optional) ---
# The bundled "web-search" skill (scripts/skills/web-search/) needs a search
# API key to do anything — without one it's inert. Prefer setting the key in
# <coop>/.henhouse/skills.json ("secrets": { "web-search": { ... } }); these
# env vars are the CLI/no-GUI fallback. Brave takes precedence over Tavily.
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- hatch mode (optional) ---
# Set to 1 (or pass --classic) to use the old hatch path: one "propose pages"
# call plus one "write this page" call per page, each re-sending the full
# source. Default is combined — a single LLM call per file that proposes the
# pages and drafts every body at once (~5x fewer calls). Kept for comparison.
KIP_HATCH_CLASSIC=
