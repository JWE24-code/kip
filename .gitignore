# Dependencies
node_modules/

# The Electron app under app/ is its own git repo — a fork of logseq/og
# (github.com/logseq/og) — and several GB. It is version-controlled
# independently; this repo tracks only the retrieval layer (scripts/) + docs.
app/

# The "coop" is personal wiki content — user data, not code. It never belongs
# in this repo. (The entries below are redundant while this line stands, but
# kept as defense-in-depth in case coop/ is ever partially un-ignored.)
coop/

# Claude Code working files (session locks, plans, handoff notes) — tooling
# scratch, not project source. Un-ignore a specific file if you want to track it.
.claude/

# Safety net: a script run with KIP_COOP_ROOT unset can create a stray .roost/
# here instead of under coop/. It's disposable either way.
/.roost/

# Real API keys/config — copy .env.example to .env and fill it in locally.
.env

# Holds provider API keys in plaintext (read/written by scripts/lib/llm.js's
# loadLLMConfig/saveLLMConfig). Never commit it.
coop/.henhouse/

# Disposable cache — rebuild any time with `npm run rebuild-roost`.
coop/.roost/*.db
coop/.roost/*.db-shm
coop/.roost/*.db-wal
coop/.roost/*.lock

# Per-run hatch/groom/peck state, telemetry, and reports — written by
# scripts/hatch-all.js, scripts/groom.js --deep, and scripts/chat.js.
coop/.roost/hatch-progress.json
coop/.roost/hatch-metrics.json
coop/.roost/hatch-trace.jsonl
coop/.roost/groom-progress.json
coop/.roost/groom-metrics.json
coop/.roost/groom-trace.jsonl
coop/.roost/groom-report.md
coop/.roost/peck-progress.json
coop/.roost/peck-metrics.json
coop/.roost/peck-trace.jsonl

# Files generated by Peck skills (a deck, a doc, a chart).
coop/exports/

# Reminders store (user data) + its per-run state.
coop/reminders.json
coop/.roost/reminders-progress.json
coop/.roost/reminders-metrics.json
coop/.roost/reminders-trace.jsonl

# Generated — rebuilt by scripts/rebuild-roost.js.
coop/nest/index.md

# Local agent instructions — never commit
AGENTS.md
